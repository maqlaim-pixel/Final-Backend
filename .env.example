# Copy to .env; never commit real credentials.
DATABASE_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=
# Generate at least 32 random bytes for this value; do not commit the generated value.
JWT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=TravelVista
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: only used to create missing staff accounts; existing accounts are untouched.
# Supply these only through the deployment environment, never commit real values.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_EDITOR_EMAIL=
BOOTSTRAP_EDITOR_PASSWORD=
