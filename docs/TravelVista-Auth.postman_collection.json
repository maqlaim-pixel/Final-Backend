        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"otp\": \"{{loginOtp}}\",\n  \"transactionId\": \"{{loginTransactionId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login/verify"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeded', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.expect(data.token).to.be.a('string'); pm.collectionVariables.set('customerToken', data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Resend Login OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"transactionId\": \"{{loginTransactionId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login/otp/resend"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeded', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.expect(data.requiresOtp).to.eql(true); pm.expect(data.token).to.eql(undefined); pm.collectionVariables.set('loginTransactionId', data.transactionId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/admin/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeded', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.expect(data.token).to.be.a('string'); pm.collectionVariables.set('adminToken', data.token);",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
