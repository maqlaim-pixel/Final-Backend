{
  "info": {
    "name": "TravelVista Customer and Admin Authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Customer registration and login both require email OTP. Set variables locally. Use an authorized Resend recipient in test mode. Resend cooldown is 60 seconds. Customer tokens last 3600 seconds."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "customerName",
      "value": "Test Customer"
    },
    {
      "key": "customerEmail",
      "value": ""
    },
    {
      "key": "customerPhone",
      "value": ""
    },
    {
      "key": "customerPassword",
      "value": ""
    },
    {
      "key": "registrationOtp",
      "value": ""
    },
    {
      "key": "registrationTransactionId",
      "value": ""
    },
    {
      "key": "loginOtp",
      "value": ""
    },
    {
      "key": "loginTransactionId",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{customerName}}\",\n  \"email\": \"{{customerEmail}}\",\n  \"phone\": \"{{customerPhone}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeded', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.expect(data.requiresOtp).to.eql(true); pm.expect(data.token).to.eql(undefined); pm.collectionVariables.set('registrationTransactionId', data.transactionId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify Registration OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"otp\": \"{{registrationOtp}}\",\n  \"transactionId\": \"{{registrationTransactionId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register/verify"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeded', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.expect(data.token).to.be.a('string'); pm.collectionVariables.set('customerToken', data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Resend Registration OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register/resend"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeded', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.expect(data.requiresOtp).to.eql(true); pm.expect(data.token).to.eql(undefined); pm.collectionVariables.set('registrationTransactionId', data.transactionId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Start Customer Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeded', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.expect(data.requiresOtp).to.eql(true); pm.expect(data.token).to.eql(undefined); pm.collectionVariables.set('loginTransactionId', data.transactionId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify Login OTP",
      "request": {
